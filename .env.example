# Copy to .env and fill in. Never commit .env.
# Every variable is read in ghost/config.py unless noted. Blank or commented out means the default.

# SEC asks every client to name itself with a contact email, e.g. "Ghost Trials Autopsy contact@example.edu".
# Required for the SEC lane and the sponsor_cik / filings snapshot tables. Use a team contact, not a personal one.
SEC_USER_AGENT=

# Optional. Raises the PubMed E-utilities limit from 3 to 10 requests per second.
NCBI_API_KEY=

# Gemini on Vertex AI. Empty VERTEX_PROJECT means the project from
# `gcloud auth application-default login` (or the Cloud Run service's own project).
VERTEX_PROJECT=
VERTEX_LOCATION=global

# Model overrides (LiteLLM model ids). Defaults shown.
# LEAD_MODEL=vertex_ai/gemini-3.5-flash
# RESEARCHER_MODEL=vertex_ai/gemini-3.5-flash-lite
# WRITER_MODEL=vertex_ai/gemini-3.5-flash
# CHECKER_MODEL=vertex_ai/gemini-3.5-flash

# Caps. Defaults shown.
# MAX_RESEARCH_ROUNDS=3
# RESEARCHER_MAX_TURNS=8
# LEAD_MAX_TURNS=6
# WRITER_MAX_TURNS=4
# CHECKER_MAX_TURNS=4
# REQUEST_BUDGET_S=240
# WRITE_RESERVE_S=75

# Data locations. Defaults: data/autopsy.duckdb and .cache/http.
# SNAPSHOT_DB=data/autopsy.duckdb
# HTTP_CACHE_DIR=.cache/http

# Read by scripts/fetch_snapshot.py at container start: download the snapshot from GCS
# when it is not in the image, e.g. gs://<bucket>/autopsy.duckdb.
# DATA_GCS_URI=
